{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capabilities for the main ImageGen window: gateway HTTP calls (any host — user-configured at runtime) and library file access under ~/Pictures/ImageGen.",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "dialog:default",
    "log:default",
    {
      "identifier": "http:default",
      "allow": [{ "url": "http://*:*" }, { "url": "https://*:*" }]
    },
    {
      "identifier": "fs:allow-read-text-file",
      "allow": [{ "path": "$PICTURE/ImageGen" }, { "path": "$PICTURE/ImageGen/**" }]
    },
    {
      "identifier": "fs:allow-read-file",
      "allow": [{ "path": "$PICTURE/ImageGen" }, { "path": "$PICTURE/ImageGen/**" }]
    },
    {
      "identifier": "fs:allow-write-file",
      "allow": [{ "path": "$PICTURE/ImageGen" }, { "path": "$PICTURE/ImageGen/**" }]
    },
    {
      "identifier": "fs:allow-write-text-file",
      "allow": [{ "path": "$PICTURE/ImageGen" }, { "path": "$PICTURE/ImageGen/**" }]
    },
    {
      "identifier": "fs:allow-mkdir",
      "allow": [{ "path": "$PICTURE/ImageGen" }, { "path": "$PICTURE/ImageGen/**" }]
    },
    {
      "identifier": "fs:allow-read-dir",
      "allow": [{ "path": "$PICTURE/ImageGen" }, { "path": "$PICTURE/ImageGen/**" }]
    },
    {
      "identifier": "fs:allow-exists",
      "allow": [{ "path": "$PICTURE/ImageGen" }, { "path": "$PICTURE/ImageGen/**" }]
    }
  ]
}
